msgid "🧠 How It Works"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:58
msgid "Core Algorithm"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:60
msgid "GSA operates through a sophisticated three-stage process:"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:62
msgid ""
"**🔐 Hash Encoding**: Convert attention keys and queries into compact hash"
" codes"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:63
msgid ""
"**🎯 Similarity Computation**: Use efficient hash-based similarity to "
"identify relevant blocks"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:64
msgid ""
"**📦 Selective Loading**: Load only the top-k most relevant KV blocks for "
"attention"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:84
msgid "🏗️ Architecture"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:86
msgid "The algorithm maintains three critical windows:"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:87
msgid "**Initial Window**: First few blocks (always loaded)"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:88
msgid "**Sparse Window**: Top-k selected blocks (dynamically chosen)"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:89
msgid "**Local Window**: Recent blocks (always loaded)"
msgstr ""

#: ../../source/user-guide/sparse-attention/gsa.md:91
msgid ""
"This design ensures both **efficiency** and **accuracy** by preserving "
"essential context while sparsifying the middle range."
msgstr ""

