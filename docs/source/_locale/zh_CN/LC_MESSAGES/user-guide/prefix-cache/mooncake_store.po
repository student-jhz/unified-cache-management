msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:92
msgid "Standalone Configuration (`Mooncake` only)"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:113
msgid "Required Parameters"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:115
msgid "**`ucm_connector_name`**:   Must be set to `\"UcmPipelineStore\"`."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:118
msgid ""
"**`store_pipeline`**:   Use `\"Mooncake|Posix\"` (recommended) or "
"`\"Mooncake\"` (standalone)."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:121
msgid ""
"**`local_hostname`** *(required)*:   The IP address of the local node. "
"Must not include a port number.   **⚠️ Replace `\"127.0.0.1\"` with the "
"actual IP of this node.**"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:125
msgid ""
"**`master_server_address`** *(required)*:   Address of the Mooncake "
"master service in `host:port` format.   Default: `\"127.0.0.1:50088\"`."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:129
msgid ""
"**`protocol`** *(required)*:   Transport protocol used by Mooncake. Use "
"`\"ascend\"` for Ascend NPU environments, `\"tcp\"` for CPU-only testing,"
" or `\"rdma\"` for InfiniBand/RoCE environments."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:132
msgid ""
"**`storage_backends`** *(required for `Mooncake|Posix`)*:   Posix storage"
" path for the persistent SSD tier.   **⚠️ Replace `\"/mnt/test\"` with "
"your actual storage path.**"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:136
msgid "Optional Parameters"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:138
msgid ""
"**`metadata_server`** *(optional, default: `\"P2PHANDSHAKE\"`)*:   "
"Metadata server address. Use `\"P2PHANDSHAKE\"` for peer-to-peer "
"handshake mode (no separate metadata server needed)."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:141
msgid ""
"**`global_segment_size_gb`** *(optional)*:   Size of the global "
"distributed memory segment in GiB.   Alternatively, set "
"`global_segment_size` in bytes. Default: ~30 GiB."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:145
msgid ""
"**`local_buffer_size_gb`** *(optional)*:   Size of the local transfer "
"buffer in GiB.   Alternatively, set `local_buffer_size` in bytes. "
"Default: 1 GiB."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:149
msgid ""
"**`replica_num`** *(optional, default: `1`)*:   Number of replicas for "
"each KV block in the Mooncake pool. Must be ≥ 1."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:152
msgid ""
"**`device_name`** *(optional, default: `\"\"`)*:   Name of the RDMA or "
"Ascend device to use (e.g., `\"mlx5_0\"` for RDMA). Leave empty to use "
"the default device."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:155
msgid ""
"**`stream_number`** *(optional, default: `4`)*:   Number of concurrent "
"transfer streams."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:158
msgid ""
"**`io_direct`** *(optional, default: `false`)*:   Whether to enable "
"direct I/O for the Posix tier (only applicable in `Mooncake|Posix` "
"pipeline)."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:161
msgid ""
"**`posix_io_engine`** *(optional, default: `\"sync\"`)*:   I/O engine for"
" the Posix tier. Options: `\"sync\"`, `\"aio\"`. Recommended: `\"aio\"`."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:164
msgid ""
"**`timeout_ms`** *(optional, default: `0` — no timeout)*:   Timeout in "
"milliseconds for transfer operations. `0` means wait indefinitely."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:167
msgid ""
"**`enable_event_sync`** *(optional, default: `false`, top-level config "
"key)*:   When set to `true`, UCM inserts a device event synchronization "
"barrier before each dump, ensuring NPU/GPU compute finishes before "
"Mooncake reads device memory. **Required for correct behavior in Ascend "
"NPU environments.**"
msgstr ""

