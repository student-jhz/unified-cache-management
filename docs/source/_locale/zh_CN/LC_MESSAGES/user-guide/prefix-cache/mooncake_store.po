#: ../../source/user-guide/prefix-cache/mooncake_store.md:37
msgid "Features"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:39
msgid "The Mooncake connector supports the following functionalities:"
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:41
msgid ""
"`dump`: Offload KV cache blocks from device (HBM/DRAM) to the Mooncake "
"distributed memory pool."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:42
msgid ""
"`load`: Retrieve KV cache blocks from the Mooncake distributed memory "
"pool back to device memory."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:43
msgid ""
"`lookup`: Check whether KV blocks are present in the Mooncake store by "
"block hash."
msgstr ""

#: ../../source/user-guide/prefix-cache/mooncake_store.md:44
msgid "`wait`: Block until all in-flight dump or load operations have completed."
msgstr ""

