#: ../../source/user-guide/prefix-cache/nfs_store.md:66
msgid "Features"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:68
msgid "The NFS connector supports the following functionalities:"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:70
msgid "`dump`: Offload KV cache blocks from HBM to SSD or Local Disk."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:71
msgid "`load`: Load KV cache blocks from SSD or Local Disk back to HBM."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:72
msgid "`lookup`: Look up KV blocks stored in SSD or Local Disk by block hash."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:73
msgid "`wait`: Ensure that all dump or load operations have completed."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:75
msgid "Configure UCM for Prefix Caching"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:77
msgid ""
"Modify the UCM configuration file to specify which UCM connector to use "
"and where KV blocks should be stored.   You may directly edit the example"
" file at:"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:80
msgid "`unified-cache-management/examples/ucm_config_example.yaml`"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:82
msgid "A minimal configuration looks like this:"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:91
msgid "Required Parameters"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:93
msgid "**ucm_connector_name**:   Specifies `UcmNfsStore` as the UCM connector."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:96
msgid ""
"**storage_backends**:   Directory used for storing KV blocks. Can be a "
"local path or an NFS-mounted path.   **⚠️ Replace `\"/mnt/test\"` with "
"your actual storage directory.**"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:100
msgid "Optional Parameters"
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:102
msgid ""
"**io_direct** (optional, default: `false`):   Whether to enable direct "
"I/O."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:105
msgid ""
"**stream_number** *(optional, default: 8)*   Number of concurrent streams"
" used for data transfer."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:108
msgid ""
"**timeout_ms** *(optional, default: 30000)*   Timeout in milliseconds for"
" external interfaces."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:111
msgid ""
"**buffer_number** *(optional, default: 4096)*   The number of "
"intermediate buffers for data transfer."
msgstr ""

#: ../../source/user-guide/prefix-cache/nfs_store.md:114
msgid ""
"**shard_data_dir** *(optional, default: true)*    Whether files are "
"spread across subdirectories or stored in a single directory."
msgstr ""

