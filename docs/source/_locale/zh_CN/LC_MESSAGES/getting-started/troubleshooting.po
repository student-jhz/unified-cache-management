#: ../../source/getting-started/troubleshooting.md:75
msgid "Required parameter is missing"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:76
msgid "Parameter value type is wrong (e.g. string where integer is expected)"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:79
msgid ""
"Check YAML syntax: validate with `python -c \"import yaml; "
"yaml.safe_load(open('your_config.yaml'))\"`"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:80
msgid ""
"Verify parameter names match the [Pipeline Store](../user-guide/prefix-"
"cache/pipeline_store.md) or [NFS Store](../user-guide/prefix-"
"cache/nfs_store.md) documentation"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:81
msgid "Ensure `storage_backends` path is a valid string, not empty"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:83
msgid "`UCM_CONFIG_FILE` not found"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:90
msgid ""
"**Cause**: The config file path in `kv_connector_extra_config` is "
"incorrect or the file does not exist."
msgstr ""

#: ../../source/getting-started/troubleshooting.md:92
msgid ""
"**Solution**: Verify the file path exists and is accessible from the "
"container or process. In Docker, ensure the file is mounted or copied "
"into the container."
msgstr ""

#: ../../source/getting-started/troubleshooting.md:94
msgid "Unsupported connector type"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:101
msgid ""
"**Cause**: The `ucm_connector_name` in the config is not a registered "
"connector."
msgstr ""

#: ../../source/getting-started/troubleshooting.md:103
msgid ""
"**Solution**: Use one of the supported connector names: "
"`UcmPipelineStore` or `UcmNfsStore`."
msgstr ""

#: ../../source/getting-started/troubleshooting.md:105
msgid "Unknown store pipeline"
msgstr ""

#: ../../source/getting-started/troubleshooting.md:112
msgid ""
"**Cause**: The `store_pipeline` value is not registered in the "
"PipelineStore registry."
msgstr ""

#: ../../source/getting-started/troubleshooting.md:114
msgid ""
"**Solution**: Use a registered pipeline such as `\"Cache|Posix\"`, "
"`\"Cache|Ds3fs\"`, `\"Cache|Compress|Posix\"`, etc. See "
"`ucm/store/pipeline/connector.py` for all registered pipelines."
msgstr ""

